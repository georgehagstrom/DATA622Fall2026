# Large regenerable data — download or generate these locally, don't commit.
# Torchvision downloads FashionMNIST/CIFAR on first run.
**/data/FashionMNIST/
**/data/CIFAR10/
*.zip
*.tar
*.tgz

# 71MB SHAP cache -- past GitHub's 50MB warning threshold, and meetup-11.qmd
# carries the (commented-out) code that regenerates it. Keep it locally so the
# deck renders fast; just don't push it. Small pickles are fine to commit.
website/meetups/meetup-11/shap_explainer.pkl

# Student submissions stay out of the public course repo
/StudentWork/
